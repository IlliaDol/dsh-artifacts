{
  "name": "dsh-artifacts",
  "version": "0.4.0",
  "description": "One generative-UI plugin for DeepSeek Harness: inline widgets, native charts, the 164-recipe visualization cookbook, cards, published pages, slides, a design canvas, docs and downloadable files. Merges the protocols of dsh-genui, dsh-visualize and dsh-generative-ui into a single artifact surface.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./skill": "./SKILL.md"
  },
  "files": [
    "lib",
    "kit",
    "cookbook",
    "recipes",
    "docs",
    "examples",
    "gallery.html",
    "PROMPT.md",
    "SKILL.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "generative-ui",
    "artifacts",
    "plugin",
    "slides",
    "charts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlliaDol/dsh-artifacts.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.1 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node --test \"test/*.test.mjs\" && node scripts/check-package.mjs",
    "render": "node scripts/render-example.mjs",
    "build:kit": "node scripts/build-kit.mjs",
    "build:cookbook": "node scripts/build-cookbook.mjs",
    "gallery": "node scripts/serve-gallery.mjs 8777"
  }
}
